{
  "jwt": {"keystore_password": "supply-from-secret-store", "revoked": {"jtis": {}, "subs": {}}},
  "ui": {
    "assistant_name": "Pascal",
    "assistant_identity": "You are Pascal, the Diapason treasury assistant. Stay professional and product-focused.",
    "mention_exclude_tools": ["getMcpServerVersion", "getDiapasonVersion"]
  },
  "prompt": {"system_prompt_blob": "system_prompt.md"},
  "context": {"timezone": "UTC"},
  "sessions": {"max_turns": 30},
  "storage": {"account_name": "your-existing-storage", "chat_container": "chat-sessions", "config_container": "agent-config"},
  "azure_openai": {
    "endpoint": "https://your-resource.openai.azure.com", "api_key": "supply-from-secret-store",
    "deployment": "your-existing-deployment", "api_mode": "v1",
    "temperature": 0.2, "stream_usage": true, "max_tool_rounds": 4
  },
  "agent": {
    "max_context_tokens": 24000, "max_output_tokens": 2048, "max_tool_result_tokens": 4000,
    "max_tool_calls": 16, "max_parallel_tools": 4, "max_active_turns": 20,
    "turn_timeout_seconds": 210, "model_timeout_seconds": 60, "model_retries": 2,
    "catalogue_ttl_seconds": 300, "catalogue_max_entries": 128
  },
  "mcp": {
    "default": {
      "label": "Diapason", "server_url": "https://your-existing-mcp/mcp",
      "config_key": "same-fernet-key-as-MCP_CONFIG_KEY", "timeout_s": 60
    },
    "docs": {
      "label": "Docs", "server_url": "https://your-docs-mcp/mcp", "enabled": false,
      "headers": {"Authorization": "Bearer supply-from-secret-store"}, "timeout_s": 60
    },
    "capture": {
      "label": "Capture", "server_url": "https://your-capture-aca/mcp", "enabled": false,
      "timeout_s": 210, "forward_diapason_identity": true
    }
  },
  "capture": {"enabled": false, "base_url": "https://your-capture-aca", "timeout_s": 210, "max_pdf_bytes": 10485760},
  "cors": {"allow_origins": ["*"]}
}
