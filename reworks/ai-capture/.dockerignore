# Tests and local config (not needed in image)
test/
config.json
config.example.json
test.api.json

# Runtime / deploy (CHAT_CONFIG + JWT_KEYSTORE_P12_B64 at runtime)
data/
deploy/
.github/
jwt_keystore.p12

# Local-only content
*.md
# Capture content is part of the image, including any Markdown prompts.
!config/
!config/**

# Frontend tooling (build on host/CI before docker; only static/js/ goes in the image)
frontend/

# Python / tooling
build/
.validation/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
.venv-ci/
.venv-smoke/
venv/

# Git / IDE
.git/
.gitignore
.cursor/

# Env files (secrets stay out of image)
.env
.env.*
*.env
*.local.*
*.secret.*
