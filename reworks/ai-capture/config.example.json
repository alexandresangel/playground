{
  "registry_url": "https://diapasondevstor.blob.core.windows.net/registry/services.json?sv=\u2026",
  "m2m": {
    "required_scope": "ai-capture",
    "jwks_cache_seconds": 600,
    "jwks_max_stale_seconds": 3600
  },
  "capture": {
    "enabled": true,
    "cache_ttl_seconds": 300,
    "max_pdf_bytes": 10485760,
    "view_entity": "loanDeposit",
    "temperature": 0.5
  },
  "azure_openai": {
    "endpoint": "https://your-resource.openai.azure.com",
    "api_key": "",
    "deployment": "your-deployment-name",
    "api_version": "2024-10-21"
  },
  "mcp": {
    "default": {
      "label": "Diapason",
      "server_url": "http://127.0.0.1:8000/mcp",
      "config_key": "same-fernet-key-as-MCP_CONFIG_KEY-on-mcp-server"
    }
  }
}
